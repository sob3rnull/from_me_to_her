# Local development only. Never commit real credentials or archive content.
APP_MODE=demo
DATABASE_URL=sqlite:///./private-data/archive.db
VAULT_ORIGIN=http://localhost:3001
# Secure mode requires PostgreSQL, HTTPS and a private Fernet key generated by:
# python -m app.admin keygen
# TOTP_ENCRYPTION_KEY=
# Temporary rotation fallback only; remove after rotate-secrets and verify-secrets:
# TOTP_PREVIOUS_ENCRYPTION_KEY=
# Public frontend URLs are build-time values, never secrets:
NEXT_PUBLIC_VAULT_URL=http://localhost:3001
# Build-time secret phrase that unlocks the hidden knock on the public site. The vault address is
# encrypted with it, so it is not in the page source. Required for any non-local vault URL; keep it
# out of Git. Use a long phrase: the ciphertext is public, so a short one can be guessed offline.
# Local demo builds default to the fictional phrase "open sesame".
# DOOR_PHRASE=
NEXT_PUBLIC_PUBLIC_SITE_URL=http://127.0.0.1:3000
